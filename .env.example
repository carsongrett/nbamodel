# Local model runs and CSV/JSON imports work with every value blank.
# Fill these in before deploying, or before using login and hosted storage.

# Public auth client. Required together with OWNER_EMAIL to turn login on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Supabase storage. Never expose this in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The only account allowed to sign in. Public sign-up stays disabled.
OWNER_EMAIL=

# Optional local store path. Defaults to data/local-store.json.
LOCAL_STORE_PATH=

# Research stays in a setup-needed state until both of these are set.
# RESEARCH_PROVIDER=openai is the only wired provider. Other names are rejected.
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
RESEARCH_API_BASE_URL=https://api.openai.com/v1
RESEARCH_MODEL=gpt-4.1-mini
RESEARCH_WEB_TOOL=web_search
